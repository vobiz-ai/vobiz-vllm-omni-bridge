# ---- Vobiz (REST, for call.py and callbacks) ----
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=+91XXXXXXXXXX        # a DID this account owns
TO_NUMBER=+91XXXXXXXXXX          # your mobile, for outbound tests

# ---- vLLM-Omni duplex server ----
# docker compose --profile gpu: the model server runs as the `vllm-omni` service on this host.
# Otherwise point REALTIME_URL at any server started with `vllm serve <model> --omni`.
REALTIME_URL=ws://vllm-omni:8091/v1/realtime?duplex=1
# the model the server loaded; also used by the compose gpu profile
OMNI_MODEL=openbmb/MiniCPM-o-4_5
OMNI_PORT=8091
# device count or "all" for the compose gpu profile
OMNI_GPUS=all
# e.g. --deploy-config /path/qwen3_omni_duplex.yaml --tensor-parallel-size 2
OMNI_EXTRA_ARGS=
# Hugging Face token for gated weights
HF_TOKEN=
# host path for the model cache; empty = named volume
HF_HOME=
# OMNI_HEALTH_URL=http://vllm-omni:8091/health   # derived from REALTIME_URL when empty
# REALTIME_API_KEY=               # only if the server sits behind an authenticating proxy
REQUIRE_DUPLEX=true               # refuse a session when session.created has no capabilities

# ---- agent ----
PERSONA=india-clinic              # generic | india-clinic
# AGENT_GREETING=                 # overrides the persona greeting
# AGENT_SYSTEM_PROMPT=            # overrides the persona prompt
# VOICE=                          # audio.output.voice, for models with named voices
TEMPERATURE=0.6
MAX_OUTPUT_TOKENS=0               # 0 = server default
INPUT_TRANSCRIPTION=true
# VAD_THRESHOLD=0.5
# VAD_SILENCE_MS=500
# VAD_PREFIX_PADDING_MS=300

# ---- audio (defaults need no conversion) ----
STREAM_CONTENT_TYPE=audio/x-l16;rate=16000   # Vobiz -> bridge. Or audio/x-l16;rate=8000, audio/x-mulaw;rate=8000. Never rate=24000.
OUTPUT_CONTENT_TYPE=audio/x-l16              # bridge -> Vobiz. Or audio/x-mulaw (forces 8000).
OUTPUT_SAMPLE_RATE=24000                     # 8000 | 16000 | 24000 for L16
MODEL_INPUT_RATE=16000
PLAY_CHUNK_MS=20
VOBIZ_L16_ENDIAN=le                          # flip to be if L16 audio is garbled
GATE_ON_CLEARED_AUDIO=true

# ---- barge-in ----
BARGE_IN_PROTECT_MS=700           # ignore caller speech this soon after a reply starts (the "hello?" on pickup)
INTERRUPT_RESPONSE=true           # server cancels its reply when the caller speaks

# ---- answer XML ----
GREETING_SOURCE=speak             # speak (Vobiz TTS before the stream) | model (duplex_initial_user_text) | none
SPEAK_VOICE=WOMAN
SPEAK_LANGUAGE=en-GB
RECORD_CALLS=false                # <Record recordSession> before <Stream>, RecordStop to /record-status
RECORD_FORMAT=mp3
RECORD_MAX_LENGTH=3600
RECORD_TRANSCRIBE=false
RECORD_DISCLOSURE=This call may be recorded for quality purposes.
STREAM_MAX_RETRIES=2
STREAM_TIMEOUT_S=3600
STREAM_STATUS_CALLBACKS=true

# ---- answering machine detection (outbound only) ----
AMD_MODE=off                      # off | sync | hangup | async
AMD_ON_MACHINE=voicemail          # voicemail | hangup | continue
AMD_HOLD_BEFORE_AGENT=true
AMD_TIME_MS=5000
AMD_INITIAL_SILENCE_MS=4500
AMD_INITIAL_GREETING_MS=1500
AMD_MAXIMUM_WORDS=3
AMD_MAXIMUM_SPEECH_LENGTH_MS=5000
VOICEMAIL_MESSAGE=
VOICEMAIL_WAIT_S=15

# ---- tools and call ending ----
TOOL_END_CALL=true                # offered to models with tool calling (Nemotron VoiceChat)
TOOL_TRANSFER=false
TRANSFER_NUMBER=
TRANSFER_TIMEOUT_S=30
TOOL_SEND_DTMF=false
DTMF_TO_MODEL=true
END_CALL_ON_GOODBYE=true          # MiniCPM-o has no tool calling: hang up after the agent says goodbye
GOODBYE_PHRASES=goodbye,good bye,bye bye,have a nice day,have a good day,take care

# ---- outbound call ----
CALLER_NAME=
TIME_LIMIT_S=1800
RING_CALLBACKS=true
SEND_DIGITS=

# ---- India compliance (checked by call.py before dialling) ----
REGION=IN
CAMPAIGN_TYPE=transactional       # promotional enforces the 10:00-20:00 IST window
ENFORCE_CALLING_WINDOW=true
CONSENT_REQUIRED=false
REQUIRE_INDIA_CALLER_ID=true

# ---- security ----
VERIFY_SIGNATURES=false           # X-Vobiz-Signature-V3/V2 on every callback (needs VOBIZ_AUTH_TOKEN)
ADMIN_TOKEN=                      # protects /calls and /flags
WS_PATH_SECRET=                   # wss://host/ws/<secret>

# ---- ops ----
MAX_CONCURRENT_CALLS=8            # keep at or below duplex_session.max_sessions on the model server
MAX_CALL_SECONDS=900
CALLER_SILENCE_HANGUP_S=0
CHECKPOINT_TIMEOUT_S=15
MODEL_CONNECT_RETRIES=2
JSON_LOGS=false
EVENTS_JSONL=true

# ---- server ----
HTTP_PORT=8000
# leave empty to reuse an ngrok tunnel on HTTP_PORT, else start cloudflared
PUBLIC_URL=
# named Cloudflare tunnel, compose --profile tunnel
TUNNEL_TOKEN=
